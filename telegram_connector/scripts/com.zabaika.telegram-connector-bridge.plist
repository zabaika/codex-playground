<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>com.zabaika.telegram-connector-bridge</string>

    <key>ProgramArguments</key>
    <array>
      <string>__SERVICE_ROOT__/scripts/run_telegram_bridge.sh</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
      <key>TELEGRAM_CONNECTOR_PROJECT_ROOT</key>
      <string>__PROJECT_ROOT__</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <true/>

    <key>WorkingDirectory</key>
    <string>__SERVICE_ROOT__</string>

    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/data/launchd/bridge.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/data/launchd/bridge.stderr.log</string>

    <key>ProcessType</key>
    <string>Background</string>
  </dict>
</plist>
